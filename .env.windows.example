# Copy to .env, replace all CHANGE_ME values, and restrict the file ACL to Administrators/SYSTEM.
APP_ENV=production
# Keep true for HTTPS/PWA; false is only for explicit trusted LAN HTTP browser mode.
SESSION_COOKIE_SECURE=true
APP_HOST=0.0.0.0
APP_PORT=18081
LOG_LEVEL=INFO
LOG_DIR=./logs
SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+asyncpg://inventory:CHANGE_ME_URL_ENCODED@127.0.0.1:5432/inventory
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=inventory
PGDATABASE=inventory
PGPASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_BIN=C:\Program Files\PostgreSQL\16\bin
BACKUP_DIR=D:\GameInventoryBackups
BACKUP_RETENTION_DAYS=30
AUTO_IMPORT_LOCAL_CATALOG=true
LOCAL_CATALOG_PATH=./data/catalog/barcode_catalog.csv
LOCAL_COVER_DIR=./data/catalog/covers
CATALOG_IMPORT_MODE=ADD_ONLY
DEFAULT_LOW_STOCK_THRESHOLD=1
DEFAULT_OVERSTOCK_THRESHOLD=10
STALE_STOCK_DAYS=30
UNDO_WINDOW_MINUTES=10
