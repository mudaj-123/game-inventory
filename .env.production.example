APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
APP_HOST_PORT=18080
SECRET_KEY=

POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory
DATABASE_URL=postgresql+asyncpg://inventory:CHANGE_ME@db:5432/inventory

DEFAULT_LOW_STOCK_THRESHOLD=1
DEFAULT_OVERSTOCK_THRESHOLD=10
STALE_STOCK_DAYS=30
UNDO_WINDOW_MINUTES=10
LOCAL_CATALOG_PATH=/app/data/catalog/barcode_catalog.csv
LOCAL_COVER_DIR=/app/data/catalog/covers
